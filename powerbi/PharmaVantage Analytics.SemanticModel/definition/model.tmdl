/// Farma Xperiun - modelo estrela. f_vendas (fato diario) + f_meta_mensal (fato de orcamento mensal), ligados por d_periodo como dimensao conformada. 6 relacoes 1:N com filtro simples, nenhuma bidirecional.
model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-US
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode","MCP-PBIModeling"]

annotation PBI_QueryOrder = ["f_vendas","d_calendario","d_produto","d_fornecedor","d_turno","f_meta_mensal","d_periodo","Servidor","Banco"]

ref table f_vendas
ref table d_calendario
ref table d_produto
ref table d_fornecedor
ref table d_turno
ref table f_meta_mensal
ref table _Medidas
ref table 'Cenário Hora Extra'
ref table d_periodo

ref cultureInfo en-US

