                      "color": "#2D3748"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "É verdade que a meta de janeiro dobrou (R$ 29.355 em 2014 → R$ 58.879 em 2019) e que, na janela comparável jan–set, a meta subiu 37,5%. Mas a meta ANUAL não é uma linha: 2017 (R$ 363.000) ficou 18% abaixo de 2016 e ABAIXO até de 2014 (R$ 364.348). É um serrilhado com um recuo grande, não um crescimento implacável.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "12px",
