{
  "name": "PharmaVantage_Corporate_Theme",
  "dataColors": [
    "#F2A93C",
    "#2FBBA8",
    "#E2585A",
    "#A9C4B8",
    "#6E93BF",
    "#9AA6B2",
    "#8FCBE0",
    "#C08552"
  ],
  "background": "#0B0F14",
  "foreground": "#F1EDE4",
  "tableAccent": "#F2A93C",
  "visualStyles": {
    "*": {
      "*": {
        "outspacePane": [
          {
            "backgroundColor": { "solid": { "color": "#0B0F14" } }
          }
        ],
        "background": [
          {
            "show": true,
            "color": { "solid": { "color": "#151B24" } },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": { "solid": { "color": "#262E38" } },
            "radius": 4
          }
        ],
        "dropShadow": [
          {
            "show": false,
            "color": { "solid": { "color": "#000000" } },
            "position": "Outer",
            "preset": "BottomRight"
          }
        ],
        "title": [
          {
            "show": true,
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 12,
            "fontColor": { "solid": { "color": "#F1EDE4" } },
            "alignment": "left"
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": { "solid": { "color": "#0B0F14" } },
            "transparency": 0
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "fontFamily": "Segoe UI Bold",
            "fontSize": 22,
            "color": { "solid": { "color": "#F1EDE4" } }
          }
        ],
        "categoryLabels": [
          {
            "fontFamily": "Segoe UI",
            "fontSize": 10,
            "color": { "solid": { "color": "#9AA6B2" } }
          }
        ]
      }
    }
  },
  "textClasses": {
    "callout": {
      "fontFace": "Segoe UI Bold",
      "fontSize": 22,
      "color": "#F1EDE4"
    },
    "title": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 12,
      "color": "#F1EDE4"
    },
    "header": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 11,
      "color": "#F1EDE4"
    },
    "label": {
      "fontFace": "Segoe UI",
      "fontSize": 9,
      "color": "#C9D3DC"
    }
  }
}
