{
  "name": "PharmaVantage_Corporate_Theme",
  "dataColors": [
    "#F4D03F",
    "#6E6E6E",
    "#8A8A8A",
    "#A8862A",
    "#4A4A4A",
    "#C9C9C9",
    "#E2585A",
    "#3FBF7F"
  ],
  "background": "#121212",
  "foreground": "#FFFFFF",
  "tableAccent": "#F4D03F",
  "visualStyles": {
    "*": {
      "*": {
        "outspacePane": [
          {
            "backgroundColor": { "solid": { "color": "#121212" } }
          }
        ],
        "background": [
          {
            "show": true,
            "color": { "solid": { "color": "#1E1E1E" } },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": { "solid": { "color": "#2E2E2E" } },
            "radius": 6
          }
        ],
        "dropShadow": [
          {
            "show": false,
            "color": { "solid": { "color": "#000000" } },
            "position": "Outer",
            "preset": "BottomRight"
          }
        ],
        "title": [
          {
            "show": true,
            "fontFamily": "Segoe UI Bold",
            "fontSize": 12,
            "fontColor": { "solid": { "color": "#FFFFFF" } },
            "alignment": "left"
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": { "solid": { "color": "#121212" } },
            "transparency": 0
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "fontFamily": "Segoe UI Black",
            "fontSize": 24,
            "color": { "solid": { "color": "#FFFFFF" } }
          }
        ],
        "categoryLabels": [
          {
            "fontFamily": "Consolas",
            "fontSize": 9,
            "color": { "solid": { "color": "#7A7A7A" } }
          }
        ]
      }
    },
    "cardVisual": {
      "*": {
        "value": [
          {
            "fontFamily": "Segoe UI Black",
            "fontSize": 24,
            "fontColor": { "solid": { "color": "#FFFFFF" } }
          }
        ],
        "label": [
          {
            "fontFamily": "Consolas",
            "fontSize": 9,
            "fontColor": { "solid": { "color": "#7A7A7A" } }
          }
        ]
      }
    }
  },
  "textClasses": {
    "callout": {
      "fontFace": "Segoe UI Black",
      "fontSize": 24,
      "color": "#FFFFFF"
    },
    "title": {
      "fontFace": "Segoe UI Bold",
      "fontSize": 12,
      "color": "#FFFFFF"
    },
    "header": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 11,
      "color": "#FFFFFF"
    },
    "label": {
      "fontFace": "Segoe UI",
      "fontSize": 9,
      "color": "#B3B3B3"
    }
  }
}
